<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_otm_attendance_report_saved_list" model="ir.ui.view">
        <field name="name">otm.attendance.report.saved.list</field>
        <field name="model">otm.attendance.report.saved</field>
        <field name="arch" type="xml">
            <list string="Saved Attendance Reports" default_order="generated_on desc">
                <field name="name"/>
                <field name="report_type"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="department_id"/>
                <field name="job_id"/>
                <field name="source"/>
                <field name="line_count"/>
                <field name="generated_on"/>
            </list>
        </field>
    </record>

    <record id="view_otm_attendance_report_saved_form" model="ir.ui.view">
        <field name="name">otm.attendance.report.saved.form</field>
        <field name="model">otm.attendance.report.saved</field>
        <field name="arch" type="xml">
            <form string="Saved Attendance Report">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="report_type"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="source"/>
                        </group>
                        <group>
                            <field name="department_id"/>
                            <field name="job_id"/>
                            <field name="generated_on"/>
                            <field name="line_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Results">
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="employee"/>
                                    <field name="department"/>
                                    <field name="job"/>
                                    <field name="date"/>
                                    <field name="detail"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_otm_attendance_report_saved_search" model="ir.ui.view">
        <field name="name">otm.attendance.report.saved.search</field>
        <field name="model">otm.attendance.report.saved</field>
        <field name="arch" type="xml">
            <search string="Search Saved Reports">
                <field name="name"/>
                <field name="report_type"/>
                <field name="department_id"/>
                <field name="job_id"/>
                <filter string="Manual" name="filter_manual" domain="[('source', '=', 'manual')]"/>
                <filter string="Auto (Daily)" name="filter_auto" domain="[('source', '=', 'auto')]"/>
                <separator/>
                <group>
                    <filter string="Report Type" name="group_report_type" context="{'group_by': 'report_type'}"/>
                    <filter string="Department" name="group_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Job Position" name="group_job" context="{'group_by': 'job_id'}"/>
                    <filter string="Source" name="group_source" context="{'group_by': 'source'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_otm_attendance_report_saved" model="ir.actions.act_window">
        <field name="name">Saved Reports</field>
        <field name="res_model">otm.attendance.report.saved</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
