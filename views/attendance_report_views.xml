<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_otm_attendance_report_wizard_form" model="ir.ui.view">
        <field name="name">otm.attendance.report.wizard.form</field>
        <field name="model">otm.attendance.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Attendance Report">
                <sheet>
                    <group>
                        <group>
                            <field name="report_type"/>
                            <field name="period"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="employee_ids" widget="many2many_tags"/>
                            <field name="department_id"/>
                        </group>
                    </group>
                    <button string="Generate Report" type="object" name="action_generate"
                            class="btn-primary" icon="fa-refresh"/>
                    <field name="line_ids" readonly="1">
                        <list>
                            <field name="employee"/>
                            <field name="department"/>
                            <field name="date"/>
                            <field name="detail"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_otm_attendance_report_wizard" model="ir.actions.act_window">
        <field name="name">Attendance Reports</field>
        <field name="res_model">otm.attendance.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
</odoo>
